{"diambil":"2026-11-09T15:19:47.570Z","isi":{"sumber":"EQuran.id (Kemenag RI)","nomor":94,"nama":"الشرح","namaLatin":"Al-Insyirah","arti":"Lapang","tempatTurun":"Mekah","jumlahAyat":8,"ayat":[{"nomor":1,"arab":"اَلَمْ نَشْرَحْ لَكَ صَدْرَكَۙ","latin":"Alam nasyraḥ laka ṣadrak(a).","terjemah":"Bukankah Kami telah melapangkan dadamu (Nabi Muhammad),"},{"nomor":2,"arab":"وَوَضَعْنَا عَنْكَ وِزْرَكَۙ","latin":"Wa waḍa‘nā ‘anka wizrak(a).","terjemah":"meringankan beban (tugas-tugas kenabian) darimu"},{"nomor":3,"arab":"الَّذِيْٓ اَنْقَضَ ظَهْرَكَۙ","latin":"Allażī anqaḍa ẓahrak(a).","terjemah":"yang memberatkan punggungmu,"},{"nomor":4,"arab":"وَرَفَعْنَا لَكَ ذِكْرَكَۗ","latin":"Wa rafa‘nā laka żikrak(a).","terjemah":"dan meninggikan (derajat)-mu (dengan selalu) menyebut-nyebut (nama)-mu?"},{"nomor":5,"arab":"فَاِنَّ مَعَ الْعُسْرِ يُسْرًاۙ","latin":"Fa'inna ma‘al-‘usri yusrā(n).","terjemah":"Maka, sesungguhnya beserta kesulitan ada kemudahan."},{"nomor":6,"arab":"اِنَّ مَعَ الْعُسْرِ يُسْرًاۗ","latin":"Inna ma‘al-‘usri yusrā(n).","terjemah":"Sesungguhnya beserta kesulitan ada kemudahan."},{"nomor":7,"arab":"فَاِذَا فَرَغْتَ فَانْصَبْۙ","latin":"Fa iżā faragta fanṣab.","terjemah":"Apabila engkau telah selesai (dengan suatu kebajikan), teruslah bekerja keras (untuk kebajikan yang lain)"},{"nomor":8,"arab":"وَاِلٰى رَبِّكَ فَارْغَبْ ࣖ","latin":"Wa ilā rabbika fargab.","terjemah":"dan hanya kepada Tuhanmu berharaplah!"}]}}
